OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=8192
PDF_DPI=150
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=20
JOB_QUEUE_SIZE=10
MAX_RETAINED_JOBS=100
JOB_RETENTION_SECONDS=3600
SSE_HEARTBEAT_SECONDS=15
# Optional: defaults to the operating system temporary directory
# UPLOAD_DIR=/tmp/po-uploads

# PO database, persistent storage, MCP and chat settings.

# PostgreSQL: async SQLAlchemy URL, also used by Alembic.
# Create the database/user first. URL-encode special characters in credentials.
DATABASE_URL=postgresql+asyncpg://po_user:change_me@localhost:5432/po_classification
# Separate disposable database for integration and migration tests.
TEST_DATABASE_URL=postgresql+asyncpg://po_user:change_me@localhost:5432/po_classification_test

# Persistent original PDFs; relative paths are resolved from the backend directory.
# Keep separate from UPLOAD_DIR, which is temporary extraction storage.
DOCUMENT_STORAGE_DIR=./storage/documents

# PO MCP server (Streamable HTTP). Keep URL consistent with host/port/path.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_TIMEOUT_SECONDS=30

# Install a tool-capable Ollama model and set its exact model tag here.
# Uses OLLAMA_HOST; independent of OLLAMA_MODEL used for PDF extraction.
PO_CHAT_MODEL=gemma4:e4b
PO_CHAT_TIMEOUT_SECONDS=120
PO_CHAT_MAX_TOOL_CALLS=8
PO_SEARCH_DEFAULT_LIMIT=20
PO_SEARCH_MAX_LIMIT=100
